# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/oziris_db?schema=public"

# Secreto para firmar los JWT (OBLIGATORIO, mínimo 32 caracteres aleatorios)
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del API
PORT=4000

# Origen(es) del frontend permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3000

# Correo para recuperación de contraseña (Gmail + contraseña de aplicación de 16 caracteres)
MAIL_USER=
MAIL_PASS=

# ── Opcionales (valores por defecto entre paréntesis) ──
# Peticiones por minuto y por IP (global: 120, registro: 10). Súbelas SOLO para pruebas de carga.
# RATE_LIMIT_GLOBAL=120
# REGISTER_RATE_LIMIT=10
# Conexiones máximas a PostgreSQL (20)
# DB_POOL_MAX=20
# Si el API está detrás de un proxy/Nginx, número de proxies (para ver la IP real del cliente)
# TRUST_PROXY=1
# En producción: NODE_ENV=production (desactiva Swagger) y ADMIN_PASSWORD obligatorio para el seed
# NODE_ENV=production
# ADMIN_PASSWORD=
