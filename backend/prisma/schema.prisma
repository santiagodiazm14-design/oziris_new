generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  bio       String?
  role      Role     @default(BUYER)
  
  tracks    Track[]
  purchases Purchase[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resetPasswordCode    String?
  resetPasswordExpires DateTime?
}

model Track {
  id           String   @id @default(uuid())
  title        String
  description  String?
  price        Float
  coverUrl     String?
  audioUrl     String
  fullAudioUrl String?
  genre        String?

  producerId   String
  producer     User     @relation(fields: [producerId], references: [id])

  purchases    Purchase[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Purchase {
  id        String   @id @default(uuid())
  amount    Float
  status    String   @default("COMPLETED")

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])

  createdAt DateTime @default(now())
}

enum Role {
  PRODUCER
  BUYER
}
