generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  lastName   String?
  artistName String?
  location   String?
  avatarUrl  String?
  bio        String?
  role       Role     @default(USER)
  isActive   Boolean  @default(true)
  
  tracks    Track[]
  purchases Purchase[]
  favorites Favorite[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resetPasswordCode    String?
  resetPasswordExpires DateTime?
}

model Track {
  id           String   @id @default(uuid())
  title        String
  description  String?
  price        Float
  coverUrl     String?
  audioUrl     String
  fullAudioUrl String?
  genre        String?
  bpm          Int?
  key          String?
  tags         String[]

  producerId   String
  producer     User     @relation(fields: [producerId], references: [id])

  purchases    Purchase[]
  favorites    Favorite[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Purchase {
  id            String   @id @default(uuid())
  amount        Float
  status        String   @default("COMPLETED")
  paymentMethod String?  @default("SIMULATED")
  licenseType   String?  @default("STANDARD")
  transactionId String?

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  trackId       String
  track         Track    @relation(fields: [trackId], references: [id])

  createdAt     DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
}

enum Role {
  USER
  ADMIN
  PRODUCER
  BUYER
}
